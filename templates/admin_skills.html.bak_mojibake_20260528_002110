    <script>
        // Modal Functions
        function openAddModal() {
            document.getElementById('addModal').style.display = 'block';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        let currentGencodeSkillId = '';

        function _escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, (s) => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[s]);
        }

        function _setPhaseStatus(phase, statusText) {
            const el = document.getElementById(`${phase}StatusBadge`);
            if (el) el.textContent = statusText || 'unknown';
        }

        function _renderReportsList(reports) {
            const entries = Object.entries(reports || {});
            if (!entries.length) return '<div>reports: (none)</div>';
            return `<div><b>reports</b><ul>${entries.map(([k, v]) => `<li><code>${_escapeHtml(k)}</code>: <code>${_escapeHtml(v)}</code></li>`).join('')}</ul></div>`;
        }

        function _renderHumanActions(data) {
            const items = Array.isArray(data?.human_action_items) ? data.human_action_items : [];
            if (!items.length) return `<div><b>requires_human_action:</b> ${data?.requires_human_action ? 'true' : 'false'}</div>`;
            return `<div><b>requires_human_action:</b> true<ul>${items.map((x) => `<li>[${_escapeHtml(x.type)}] ${_escapeHtml(x.message)} (${_escapeHtml(x.suggested_action)})</li>`).join('')}</ul></div>`;
        }

        function openGencodeWizard(skillId) {
            currentGencodeSkillId = skillId;
            document.getElementById('gencodeSkillId').textContent = skillId;
            document.getElementById('gencodePhase1Result').textContent = '尚未執行 Phase 1';
            document.getElementById('gencodePhase2Result').textContent = '尚未執行 Phase 2';
            document.getElementById('gencodePhase3Result').textContent = '尚未執行 Phase 3';
            _setPhaseStatus('phase1', '尚未執行');
            _setPhaseStatus('phase2', '尚未執行');
            _setPhaseStatus('phase3', '尚未執行');
            document.getElementById('gencodePhase1Btn').disabled = false;
            document.getElementById('gencodePhase2Btn').disabled = true;
            document.getElementById('gencodePhase3Btn').disabled = true;
            document.getElementById('gencodeModal').style.display = 'block';
        }

        async function runGencodePhase1() {
            if (!currentGencodeSkillId) return;
            const btn = document.getElementById('gencodePhase1Btn');
            const box = document.getElementById('gencodePhase1Result');
            btn.disabled = true;
            box.textContent = '執行中...';
            _setPhaseStatus('phase1', '執行中');
            try {
                const resp = await fetch(`/admin/gencode/skills/${encodeURIComponent(currentGencodeSkillId)}/phase1`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ dry_run: true })
                });
                const data = await resp.json();
                if (!resp.ok || !data.ok) throw new Error(data.error || data.summary_message || `HTTP ${resp.status}`);
                _setPhaseStatus('phase1', data.phase_status || '完成');
                const candidates = Array.isArray(data.candidate_problem_types) ? data.candidate_problem_types : [];
                const rows = candidates.map((c) => `<tr><td>${_escapeHtml(c.problem_type_id || c.proposed_problem_type_id || '')}</td><td>${_escapeHtml(c.matched_example_count ?? 0)}</td><td>${_escapeHtml(c.checker_key_proposal || '')}</td><td>${_escapeHtml(c.equivalence_type_proposal || '')}</td></tr>`).join('');
                box.innerHTML = `
                    <div class="gencode-summary">${_escapeHtml(data.summary_message || '')}</div>
                    <div><b>來源題數:</b> ${_escapeHtml(data.source_example_count ?? 0)}；<b>候選題型數:</b> ${candidates.length}</div>
                    <table><thead><tr><th>problem_type_id</th><th>matched</th><th>checker</th><th>equivalence</th></tr></thead><tbody>${rows || '<tr><td colspan="4">(none)</td></tr>'}</tbody></table>
                    ${_renderHumanActions(data)}
                    ${_renderReportsList(data.reports)}
                `;
                document.getElementById('gencodePhase2Btn').disabled = !data.can_continue;
            } catch (e) {
                _setPhaseStatus('phase1', '錯誤');
                box.innerHTML = `<div style="color:#b91c1c;"><b>錯誤:</b> ${_escapeHtml(e.message || String(e))}</div>`;
                Swal.fire('Phase 1 錯誤', String(e.message || e), 'error');
            } finally { btn.disabled = false; }
        }

        async function runGencodePhase2() {
            if (!currentGencodeSkillId) return;
            const btn = document.getElementById('gencodePhase2Btn');
            const box = document.getElementById('gencodePhase2Result');
            btn.disabled = true;
            box.textContent = '執行中...';
            _setPhaseStatus('phase2', '執行中');
            try {
                const resp = await fetch(`/admin/gencode/skills/${encodeURIComponent(currentGencodeSkillId)}/phase2`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ dry_run: true, accepted_problem_types: [], excluded_example_ids: [] })
                });
                const data = await resp.json();
                if (!resp.ok || !data.ok) throw new Error(data.error || data.summary_message || `HTTP ${resp.status}`);
                _setPhaseStatus('phase2', data.phase_status || '完成');
                const results = Array.isArray(data.generator_results) ? data.generator_results : [];
                const rows = results.map((r) => `<tr><td>${_escapeHtml(r.problem_type_id || '')}</td><td>${_escapeHtml(r.generator_key || '')}</td><td>${_escapeHtml(r.generator_status || '')}</td><td>${_escapeHtml(r.checker_smoke_status || '')}</td><td>${_escapeHtml(r.dynamic_sampling_status || '')}</td><td>${_escapeHtml((r.warnings || []).join(','))}</td><td>${_escapeHtml((r.blockers || []).join(','))}</td></tr>`).join('');
                box.innerHTML = `
                    <div class="gencode-summary">${_escapeHtml(data.summary_message || '')}</div>
                    <table><thead><tr><th>problem_type_id</th><th>generator_key</th><th>status</th><th>checker_smoke</th><th>sampling</th><th>warnings</th><th>blockers</th></tr></thead><tbody>${rows || '<tr><td colspan="7">(none)</td></tr>'}</tbody></table>
                    ${_renderHumanActions(data)}
                    ${_renderReportsList(data.reports)}
                `;
                document.getElementById('gencodePhase3Btn').disabled = !data.can_continue;
            } catch (e) {
                _setPhaseStatus('phase2', '錯誤');
                box.innerHTML = `<div style="color:#b91c1c;"><b>錯誤:</b> ${_escapeHtml(e.message || String(e))}</div>`;
                Swal.fire('Phase 2 錯誤', String(e.message || e), 'error');
            } finally { btn.disabled = false; }
        }

        async function runGencodePhase3() {
            if (!currentGencodeSkillId) return;
            const btn = document.getElementById('gencodePhase3Btn');
            const box = document.getElementById('gencodePhase3Result');
            btn.disabled = true;
            box.textContent = '執行中...';
            _setPhaseStatus('phase3', '執行中');
            try {
                const resp = await fetch(`/admin/gencode/skills/${encodeURIComponent(currentGencodeSkillId)}/phase3`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ dry_run: true, accepted_generator_keys: [] })
                });
                const data = await resp.json();
                if (!resp.ok || !data.ok) throw new Error(data.error || data.summary_message || `HTTP ${resp.status}`);
                _setPhaseStatus('phase3', data.phase_status || '完成');
                const pc = data.publish_check || {};
                const draftPassMsg = pc.draft_check_passed ? '<div class="gencode-summary">draft 已產生，尚未覆寫正式技能程式</div>' : '';
                const runtimeBlockMsg = pc.can_mark_runtime_ready === false ? '<div class="gencode-summary">尚未 runtime-ready，不可直接開放學生端</div>' : '';
                const formalCandidateMsg = (pc.can_publish_formal && data.dry_run) ? '<div class="gencode-summary">可作為正式發布候選，但本次 dry-run 未覆寫正式技能程式</div>' : '';
                const publishControls = pc.can_publish_formal ? `
                    <div style="margin-top:10px; border-top:1px solid #e5e7eb; padding-top:10px;">
                      <div><b>正式發布</b>：draft 已通過檢查，可發布為正式技能檔。發布前會自動備份舊檔。</div>
                      <div style="margin-top:8px; display:flex; gap:8px;">
                        <button type="button" class="btn btn-secondary" onclick="runGencodePublishDraft(false)">預覽發布</button>
                        <button type="button" class="btn btn-secondary" onclick="runGencodePublishDraft(true)">確認發布</button>
                      </div>
                      <div id="gencodePublishResult" class="gencode-result-box" style="margin-top:8px;">尚未執行發布動作</div>
                    </div>
                ` : '';
                box.innerHTML = `
                    <div class="gencode-summary">${_escapeHtml(data.summary_message || '')}</div>
                    <table><tbody>
                        <tr><th>phase_status</th><td>${_escapeHtml(data.phase_status || '')}</td></tr>
                        <tr><th>skill_file_path</th><td><code>${_escapeHtml(data.skill_file_path || '')}</code></td></tr>
                        <tr><th>package_status</th><td>${_escapeHtml(data.package_status || '')}</td></tr>
                        <tr><th>py_compile_status</th><td>${_escapeHtml(data.py_compile_status || '')}</td></tr>
                        <tr><th>runtime_smoke_status</th><td>${_escapeHtml(data.runtime_smoke_status || '')}</td></tr>
                        <tr><th>next_action</th><td>${_escapeHtml(data.next_action || '')}</td></tr>
                    </tbody></table>
                    <h4>publish_check</h4>
                    <table><tbody>
                        <tr><th>draft_check_passed</th><td>${_escapeHtml(pc.draft_check_passed)}</td></tr>
                        <tr><th>can_publish_draft</th><td>${_escapeHtml(pc.can_publish_draft)}</td></tr>
                        <tr><th>can_publish_formal</th><td>${_escapeHtml(pc.can_publish_formal)}</td></tr>
                        <tr><th>can_mark_runtime_ready</th><td>${_escapeHtml(pc.can_mark_runtime_ready)}</td></tr>
                        <tr><th>formal_publish_blockers</th><td>${_escapeHtml((pc.formal_publish_blockers || []).join(', ') || '(none)')}</td></tr>
                        <tr><th>runtime_ready_blockers</th><td>${_escapeHtml((pc.runtime_ready_blockers || []).join(', ') || '(none)')}</td></tr>
                        <tr><th>warnings</th><td>${_escapeHtml((pc.warnings || []).join(', ') || '(none)')}</td></tr>
                        <tr><th>blockers</th><td>${_escapeHtml((pc.blockers || []).join(', ') || '(none)')}</td></tr>
                        <tr><th>summary_message</th><td>${_escapeHtml(pc.summary_message || '')}</td></tr>
                    </tbody></table>
                    ${draftPassMsg}
                    ${runtimeBlockMsg}
                    ${formalCandidateMsg}
                    ${_renderReportsList(data.reports)}
                    ${publishControls}
                `;
            } catch (e) {
                _setPhaseStatus('phase3', '錯誤');
                box.innerHTML = `<div style="color:#b91c1c;"><b>錯誤:</b> ${_escapeHtml(e.message || String(e))}</div>`;
                Swal.fire('Phase 3 錯誤', String(e.message || e), 'error');
            } finally { btn.disabled = false; }
        }

        async function runGencodePublishDraft(confirmPublish) {
            if (!currentGencodeSkillId) return;
            if (confirmPublish) {
                const result = await Swal.fire({
                    title: '確認正式發布',
                    text: '將把 draft 技能檔發布到 skills/{skill_id}.py，並先建立備份。',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: '確認發布',
                    cancelButtonText: '取消'
                });
                if (!result.isConfirmed) return;
            }
            const target = document.getElementById('gencodePublishResult');
            if (target) target.textContent = '執行中...';
            try {
                const resp = await fetch(`/admin/gencode/skills/${encodeURIComponent(currentGencodeSkillId)}/publish-draft`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ confirm: !!confirmPublish, allow_runtime_ready: false })
                });
                const data = await resp.json();
                if (!resp.ok || !data.ok) throw new Error(data.error || data.summary_message || `HTTP ${resp.status}`);
                const runtimeMsg = data.runtime_ready_marked ? '已標記 runtime-ready。' : '已發布技能檔，但尚未 runtime-ready。';
                if (target) {
                    target.innerHTML = `
                        <table><tbody>
                            <tr><th>publish_status</th><td>${_escapeHtml(data.publish_status || '')}</td></tr>
                            <tr><th>formal_skill_file_path</th><td><code>${_escapeHtml(data.formal_skill_file_path || '')}</code></td></tr>
                            <tr><th>backup_path</th><td><code>${_escapeHtml(data.backup_path || '')}</code></td></tr>
                            <tr><th>backup_status</th><td>${_escapeHtml(data.backup_status || '')}</td></tr>
                            <tr><th>py_compile_status</th><td>${_escapeHtml(data.py_compile_status || '')}</td></tr>
                            <tr><th>runtime_smoke_status</th><td>${_escapeHtml(data.runtime_smoke_status || '')}</td></tr>
                            <tr><th>runtime_ready_marked</th><td>${_escapeHtml(data.runtime_ready_marked)}</td></tr>
                            <tr><th>summary_message</th><td>${_escapeHtml(data.summary_message || '')}</td></tr>
                        </tbody></table>
                        <div class="gencode-summary">${_escapeHtml(runtimeMsg)}</div>
                    `;
                }
            } catch (e) {
                if (target) target.innerHTML = `<div style="color:#b91c1c;"><b>錯誤:</b> ${_escapeHtml(e.message || String(e))}</div>`;
                Swal.fire('錯誤', String(e.message || e), 'error');
            }
        }


