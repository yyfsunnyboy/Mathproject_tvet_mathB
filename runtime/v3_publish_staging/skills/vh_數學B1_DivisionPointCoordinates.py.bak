    dispatch_check,
    dispatch_generate,
    dispatch_get_hint,
)

SKILL_ID = 'vh_數學B1_DivisionPointCoordinates'
GENERATOR_KEYS = ['src_4420', 'src_4421', 'src_4423', 'src_4427', 'src_4438', 'src_4512', 'src_4513']
