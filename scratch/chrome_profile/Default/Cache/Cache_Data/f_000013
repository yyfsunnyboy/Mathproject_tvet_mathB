        <div class="page-header">
            <h1>
                <i class="bi bi-file-earmark-text" style="color: #e74c3c;"></i> 考卷診斷系統
            </h1>
        </div>

        <div class="card">
            <div class="card-header">
                <i class="bi bi-upload"></i> 上傳考卷圖片
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label for="gradeSelect">選擇年級</label>
                    <select id="gradeSelect" class="form-select">
                        <option value="">-- 請選擇年級 --</option>
                        <option value="7">國一</option>
                        <option value="8">國二</option>
                        <option value="9">國三</option>
