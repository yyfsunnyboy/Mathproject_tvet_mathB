                <div class="upload-area" id="uploadArea">
                    <div class="upload-icon"><i class="bi bi-cloud-upload"></i></div>
                    <div class="upload-text">點擊或拖放圖片到這裡</div>
                    <div class="upload-hint">支援 JPG, PNG, GIF 格式,檔案大小限制 5MB,可一次上傳多張圖片</div>
                    <input type="file" id="fileInput" accept="image/*" multiple>
                </div>

                <div class="preview-container" id="previewContainer"></div>

                <button class="btn btn-submit" id="submitBtn" disabled>開始分析</button>

