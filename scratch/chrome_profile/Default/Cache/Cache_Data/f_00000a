    <script>
        let radarChart = null;

        // 頁面載入時自動執行診斷
        window.addEventListener('DOMContentLoaded', function () {
            loadDiagnosis(false);
        });

        // 載入診斷資料
        function loadDiagnosis(forceRefresh) {
            // 顯示載入中
            document.getElementById('loading-overlay').style.display = 'flex';
            document.getElementById('diagnosis-result').style.display = 'none';
            document.getElementById('error-message').style.display = 'none';

            // 呼叫 API
            fetch('/student/analyze_weakness', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    force_refresh: forceRefresh
                })
            })
                .then(response => response.json())
                .then(data => {
                    document.getElementById('loading-overlay').style.display = 'none';
                    if (data.success) {
                        displayDiagnosis(data.data, data.cached);
                    } else {
                        showError(data.error || '分析失敗');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('loading-overlay').style.display = 'none';
                    showError('網路錯誤,請稍後再試');
                });
        }

        // 顯示診斷結果
        function displayDiagnosis(data, isCached) {
            document.getElementById('diagnosis-result').style.display = 'block';

            // 顯示快取指示器
            if (isCached) {
                document.getElementById('cache-indicator').style.display = 'inline-block';
            } else {
                document.getElementById('cache-indicator').style.display = 'none';
            }

            // 顯示 AI 評語
            document.getElementById('ai-comment').textContent = data.ai_comment || '暫無評語';

            // 顯示建議單元
            document.getElementById('recommended-unit').textContent = data.recommended_unit || '暫無建議';

            // 顯示分析時間
            document.getElementById('analysis-time').textContent = data.created_at || '-';

            // 繪製雷達圖
            drawRadarChart(data.radar_chart_data);
        }

        // 繪製雷達圖
        function drawRadarChart(masteryScores) {
            const labels = Object.keys(masteryScores);
            const scores = Object.values(masteryScores);

            // 如果已有圖表,先銷毀
            if (radarChart) {
                radarChart.destroy();
            }

            const ctx = document.getElementById('radarChart').getContext('2d');
            radarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: '熟練度分數',
                        data: scores,
                        backgroundColor: 'rgba(52, 152, 219, 0.2)',
                        borderColor: 'rgba(52, 152, 219, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: 'rgba(52, 152, 219, 1)',
                        pointBorderColor: '#fff',
                        pointHoverBackgroundColor: '#fff',
                        pointHoverBorderColor: 'rgba(52, 152, 219, 1)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                stepSize: 20
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    }
                }
            });
        }

        // 顯示錯誤訊息
        function showError(message) {
            document.getElementById('diagnosis-result').style.display = 'none';
            document.getElementById('error-message').style.display = 'block';
            document.getElementById('error-text').textContent = message;
        }

        // 重新分析
        function refreshAnalysis() {
            if (confirm('確定要重新分析嗎?這將使用最新的學習記錄進行診斷。')) {
                loadDiagnosis(true);
            }
        }
    </script>
