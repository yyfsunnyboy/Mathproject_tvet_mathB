                分析時間: <span id="analysis-time">-</span>
            </div>
        </div>

        <!-- 錯誤訊息 -->
        <div id="error-message" class="card" style="display: none;">
            <div class="card-body error-card">
                <h4><i class="bi bi-exclamation-triangle"></i> 無法載入診斷報告</h4>
                <p id="error-text"></p>
                <button class="btn" onclick="loadDiagnosis(false)">重試</button>
            </div>
        </div>
