    {
      "source_description": "3-1習題 基礎題 4",
      "skill_id": "vh_數學B2_SubSection_3_1_3",
      "problem_type": "textbook_exercise",
      "problem_text": "如圖，在四邊形ABCD中，試求：\n(1)\\(\\overrightarrow{BC}\\ -\\overrightarrow{BD}\\) (2)\\(\\overrightarrow{AB}\\ +\\overrightarrow{BC}\\ -\\overrightarrow{DC}\\ +\\overrightarrow{DA}\\)"
    },
    {
